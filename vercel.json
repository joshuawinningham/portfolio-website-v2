{
  "framework": "astro",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/fractional-web-product-developer",
      "destination": "https://www.scalevisibility.com/web-design/",
      "permanent": true
    },
    {
      "source": "/fractional-web-product-developer/",
      "destination": "https://www.scalevisibility.com/web-design/",
      "permanent": true
    },
    {
      "source": "/fractional-marketing-operations",
      "destination": "https://www.scalevisibility.com/services/",
      "permanent": true
    },
    {
      "source": "/fractional-marketing-operations/",
      "destination": "https://www.scalevisibility.com/services/",
      "permanent": true
    },
    {
      "source": "/Joshua_Winningham_Digital_Marketing_Resume.pdf",
      "destination": "/Joshua_Winningham_Full_Stack_Resume.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

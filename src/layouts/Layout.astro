---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
	/** Keep the page out of search indexes (error pages). */
	noindex?: boolean;
}

	const {
	title,
	description = "Josh Winningham, full-stack software engineer: production web products built and operated end to end. Portfolio, résumé, and how to work with me. Founder of Scale Visibility.",
	image = "/images/og-image-developer.jpg",
	article = false,
	noindex = false,
} = Astro.props;

// Safely get the canonical URL
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: new URL(Astro.url.pathname, Astro.url.origin);

// Social-share image as an absolute URL (scrapers reject relative paths).
const ogImageURL = new URL(image, Astro.site ?? Astro.url).href;

const keywords =
	"Josh Winningham, Full-Stack Software Engineer, Full-Stack Developer, Product Engineer, Web Developer, React, Next.js, ASP.NET Core, TypeScript, PostgreSQL, AWS, SaaS, Marketplace Development, Software Engineer, Portfolio, Technical SEO";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Theme initialization (must run before paint to avoid a flash).
		     Default is dark; only an explicit "light" choice overrides it. -->
		<script is:inline>
			const stored = localStorage.getItem("jw-theme");
			document.documentElement.setAttribute(
				"data-theme",
				stored === "light" ? "light" : "dark",
			);
		</script>

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Josh Winningham" />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<meta name="theme-color" content="#1F6B3E" />

		<!-- Fonts — self-hosted subsets (see public/fonts); preloaded so text settles on first paint -->
		<link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-var.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-var.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-italic-var.woff2" crossorigin />
		<meta name="format-detection" content="telephone=no" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta
			property="og:site_name"
			content="Josh Winningham"
		/>
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL} />
		<meta name="twitter:creator" content="@joshuawinningham" />
		<meta name="twitter:site" content="@joshuawinningham" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Structured Data -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": article ? "Article" : "Person",
				name: "Josh Winningham",
				url: canonicalURL,
				image: ogImageURL,
				description: description,
				jobTitle: "Full-Stack Software Engineer",
				sameAs: [
					"https://github.com/joshuawinningham",
					"https://linkedin.com/in/joshuawinningham",
				],
				skills: [
					"React",
					"Next.js",
					"TypeScript",
					"ASP.NET Core",
					"Astro",
					"Python",
					"AWS",
					"SEO",
					"Full Stack Development",
				],
			})}
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />

		<script>
			// Scroll reveal — above-fold blocks show immediately; the rest fade up
			// as they enter the viewport. Respects prefers-reduced-motion via CSS.
			const revealEls = Array.from(
				document.querySelectorAll<HTMLElement>("[data-reveal]"),
			);
			if ("IntersectionObserver" in window) {
				const revealObs = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("r-shown");
								revealObs.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.05, rootMargin: "0px 0px 0px 0px" },
				);
				const fold = (window.innerHeight || 0) * 0.92;
				revealEls.forEach((el) => {
					if (el.getBoundingClientRect().top < fold) {
						el.classList.add("r-shown");
					} else {
						revealObs.observe(el);
					}
				});
			} else {
				revealEls.forEach((el) => el.classList.add("r-shown"));
			}

			// Active-nav highlighting — the Work/About/Contact link for the section
			// currently in view gets an accent underline.
			const navLinks = new Map<string, Element>();
			document
				.querySelectorAll<HTMLAnchorElement>(".jw-nav-link[data-nav]")
				.forEach((link) => {
					if (link.dataset.nav) navLinks.set(link.dataset.nav, link);
				});
			const sections = ["services", "work", "about", "contact"]
				.map((id) => document.getElementById(id))
				.filter((s): s is HTMLElement => Boolean(s));

			if ("IntersectionObserver" in window && sections.length) {
				const ratios = new Map<string, number>();
				let current = "";
				const navObs = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => ratios.set(e.target.id, e.intersectionRatio));
						let best = "";
						let bestRatio = 0;
						ratios.forEach((ratio, id) => {
							if (ratio > bestRatio) {
								bestRatio = ratio;
								best = id;
							}
						});
						if (bestRatio < 0.05) best = "";
						if (best !== current) {
							current = best;
							navLinks.forEach((link, id) =>
								link.classList.toggle("jw-nav-on", id === best),
							);
						}
					},
					{ threshold: [0.05, 0.25, 0.5, 0.75], rootMargin: "-72px 0px -40% 0px" },
				);
				sections.forEach((s) => navObs.observe(s));
			}
		</script>
	</body>
</html>

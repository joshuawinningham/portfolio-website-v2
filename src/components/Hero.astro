---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import providerDirectoryShot from "../assets/its-an-art-party-nextjs.png";
---

<section id="top" data-r="hero" class="hero">
	<div class="hero-copy">
		<div class="eyebrow">
			<span class="eyebrow-dot"></span>
			Web &amp; Product Developer · Phoenix, AZ · Remote
		</div>
		<h1 class="hero-title">
			I build and operate <em>production web products</em>.
		</h1>
		<p class="hero-lede">
			I’m Josh Winningham, a full-stack web and product developer. I take
			products from requirements to production and keep them running: accounts,
			payments, integrations, data pipelines, deployment, and maintenance.
			Currently the founder of Scale Visibility, where I design and build
			websites that search engines and AI tools understand. Open to full-time,
			contract, or a project.
		</p>
		<div class="hero-ctas">
			<a href="#work" class="btn-fill">View portfolio <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
			<a href="/Joshua_Winningham_Full_Stack_Resume.pdf" download class="btn-ghost">Download résumé <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
		</div>
	</div>

	<div class="hero-shot-wrap">
		<div class="browser">
			<div class="browser-bar">
				<span class="dot dot-red"></span>
				<span class="dot dot-yellow"></span>
				<span class="dot dot-green"></span>
				<span class="browser-url">itsanartparty.com</span>
			</div>
			<div class="browser-screen">
				<Image src={providerDirectoryShot} alt="It's an Art Party provider directory" loading="eager" />
			</div>
		</div>
		<div class="shot-caption">
			<span class="caption-dot"></span>
			<div>
				<div class="caption-kicker">Production platform</div>
				<div class="caption-title">Multi-City Provider Directory</div>
			</div>
		</div>
	</div>
</section>

<style>
	.secondary-paths { display: flex; flex-wrap: wrap; gap: 12px 22px; }
	.secondary-paths a { color: var(--fg2); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 64px 32px 64px;
		display: grid;
		grid-template-columns: 1.04fr 0.96fr;
		gap: 60px;
		align-items: center;
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg2);
	}
	.eyebrow-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-bright);
	}
	.hero-title {
		font-family: "Newsreader", serif;
		font-size: clamp(44px, 4.8vw, 64px);
		line-height: 1.03;
		letter-spacing: -0.02em;
		font-weight: 420;
		margin: 0;
		font-variation-settings: "opsz" 72;
	}
	.hero-title em {
		font-style: italic;
		color: var(--accent);
	}
	.hero-lede {
		font-size: 19px;
		line-height: 1.58;
		color: var(--fg2);
		margin: 0;
		max-width: 48ch;
	}
	.hero-ctas {
		display: flex;
		flex-direction: column;
		max-width: 430px;
		gap: 13px;
		margin-top: 6px;
	}
	.btn-fill {
		display: inline-flex;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		padding: 14px 24px;
		background: var(--primary);
		color: var(--primary-ink);
		border-radius: 10px;
	}
	.btn-fill:hover {
		background: var(--primary-hover);
	}
	.btn-ghost {
		display: inline-flex;
		justify-content: space-between;
		align-items: center;
		gap: 7px;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		padding: 14px 24px;
		background: transparent;
		color: var(--ink);
		border: 1px solid var(--line2);
		border-radius: 10px;
	}
	.btn-ghost:hover {
		border-color: var(--ink);
	}
	.hero-shot-wrap {
		position: relative;
	}
	.browser {
		border-radius: 14px;
		overflow: hidden;
		background: var(--card);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-lift);
	}
	.browser-bar {
		height: 38px;
		background: var(--chrome);
		border-bottom: 1px solid var(--line);
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 0 14px;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.dot-red {
		background: #e8533c;
	}
	.dot-yellow {
		background: #d4a23a;
	}
	.dot-green {
		background: #3da858;
	}
	.browser-url {
		margin-left: 12px;
		flex: 1;
		max-width: 230px;
		height: 20px;
		border-radius: 6px;
		background: var(--bg);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		padding: 0 10px;
		font-family: "JetBrains Mono", monospace;
		font-size: 10.5px;
		color: var(--fg2);
	}
	.browser-screen {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg);
	}
	.browser-screen :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.shot-caption {
		position: absolute;
		bottom: -20px;
		left: 24px;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 11px 15px;
		box-shadow: var(--shadow);
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.caption-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--primary);
	}
	.caption-kicker {
		font-family: "JetBrains Mono", monospace;
		font-size: 10px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--fg2);
	}
	.caption-title {
		font-family: "Newsreader", serif;
		font-style: italic;
		font-size: 14.5px;
		color: var(--ink);
	}
</style>

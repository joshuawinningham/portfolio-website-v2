---
import ProjectCard from "./ProjectCard.astro";
import type { ServiceProofItem } from "../data/serviceProof";
interface Props { items: ServiceProofItem[]; description: string; }
const { items, description } = Astro.props;
---
<section id="proof" class="wrap section-space" aria-labelledby="proof-title">
	<div class="section-intro">
		<div><p class="eyebrow">Relevant work</p><h2 id="proof-title">Built, connected,<br />and put to use.</h2></div>
		<p>{description}</p>
	</div>
	<div class:list={["proof-grid", { "proof-grid-three": items.length === 3 }]}>
		{items.map(({ project, relevance }) => <ProjectCard project={project} blurb={relevance} inDefault={true} />)}
	</div>
</section>
<style>
	.proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
	.proof-grid-three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	@media (max-width: 1000px) { .proof-grid-three { grid-template-columns: 1fr; } }
	@media (max-width: 650px) { .proof-grid { grid-template-columns: 1fr; } }
</style>

---
import Icon from "./Icon.astro";
import ContactForm from "./ContactForm.astro";
---

<section id="contact" data-r="contact-sec" class="contact">
	<div data-r="contact" data-reveal class="contact-inner">
		<div class="contact-lead">
			<p class="eyebrow">Contact</p>
			<h2 class="contact-title">Let’s talk about what you need.</h2>
			<p class="contact-lede">
				Open to full-time, contract, or a project. Tell me what you’re building,
				what the role or engagement looks like, and where you’re stuck, and we’ll
				talk through fit.
			</p>
			<a href="mailto:joshua.winningham@gmail.com" class="contact-email">
				<Icon name="mail" size={20} aria-hidden="true" /> joshua.winningham@gmail.com
			</a>
			<div class="contact-socials">
				<a
					href="https://github.com/joshuawinningham"
					target="_blank"
					rel="noopener noreferrer"
					class="social-btn"
				>
					<Icon name="github" size={16} aria-hidden="true" /> GitHub
				</a>
				<a
					href="https://linkedin.com/in/joshuawinningham"
					target="_blank"
					rel="noopener noreferrer"
					class="social-btn"
				>
					<Icon name="linkedin" size={16} aria-hidden="true" /> LinkedIn
				</a>
			</div>
		</div>

		<ContactForm />
	</div>
</section>

<style>
	.contact {
		scroll-margin-top: 80px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 90px 32px;
	}
	.contact-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: start;
	}
	.eyebrow {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg2);
		margin: 0 0 16px;
	}
	.contact-title {
		font-family: "Newsreader", serif;
		font-size: clamp(34px, 4vw, 50px);
		letter-spacing: -0.018em;
		font-weight: 450;
		line-height: 1.06;
		margin: 0 0 22px;
		font-variation-settings: "opsz" 48;
	}
	.contact-lede {
		font-size: 17px;
		line-height: 1.6;
		color: var(--fg2);
		margin: 0 0 30px;
		max-width: 42ch;
	}

	.contact-email {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: "Newsreader", serif;
		font-style: italic;
		font-size: clamp(18px, 4.5vw, 24px);
		color: var(--accent);
		text-decoration: none;
	}
	.contact-email:hover {
		color: var(--accent-bright);
	}
	.contact-socials {
		display: flex;
		gap: 11px;
		margin-top: 30px;
	}
	.social-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		color: var(--ink);
		border: 1px solid var(--line2);
		border-radius: 9px;
		padding: 11px 18px;
	}
	.social-btn:hover {
		border-color: var(--ink);
	}

</style>

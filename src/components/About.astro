---
import { marketingSkills, frontendSkills, backendSkills } from "../data/projects";
---

<section id="about" class="about">
	<div data-r="about" data-reveal class="about-inner">
		<div class="about-lead">
			<p class="eyebrow">About</p>
			<h2 class="about-title">A marketer who builds the site, and a developer who has run the business.</h2>
			<div class="about-stats">
				<div>
					<div class="stat-num">39,200+</div>
					<div class="stat-label">email subscribers grown</div>
				</div>
				<div>
					<div class="stat-num">16+</div>
					<div class="stat-label">years in remote digital business</div>
				</div>
				<div>
					<div class="stat-num">5,200+</div>
					<div class="stat-label">SaaS users served</div>
				</div>
			</div>
		</div>
		<div class="about-body">
			<p class="about-para">
				My background combines 16+ years of remote entrepreneurship with hands-on web
				development. At Cleaning Business Academy I built an email audience of more
				than 39,200 subscribers, sold an online course to more than 670 customers, and
				earned first-page Google rankings for multiple national keywords. At MaidGrow I
				oversaw an estimate calculator used by more than 5,200 cleaning business owners.
				Today I independently build and maintain web products in React, Next.js,
				TypeScript, and Node.js — Scale Visibility, an AI-search readiness platform;
				It's an Art Party, a multi-city provider directory; and TrueTourney, a youth
				sports tournament directory — handling technical SEO, structured data,
				city-specific pages, authentication, payments, and email workflows myself.
			</p>
			<div data-r="about-skills" class="about-skills">
				<div class="skill-group-wide">
					<div class="skill-head">SEO &amp; marketing</div>
					<div class="chip-row">
						{marketingSkills.map((t) => <span class="skill-chip">{t}</span>)}
					</div>
				</div>
				<div>
					<div class="skill-head">Frontend</div>
					<div class="chip-row">
						{frontendSkills.map((t) => <span class="skill-chip">{t}</span>)}
					</div>
				</div>
				<div>
					<div class="skill-head">Backend &amp; tools</div>
					<div class="chip-row">
						{backendSkills.map((t) => <span class="skill-chip">{t}</span>)}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		scroll-margin-top: 80px;
		background: var(--bg-alt);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.about-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 88px 32px;
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 64px;
		align-items: start;
	}
	.eyebrow {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg2);
		margin: 0 0 16px;
	}
	.about-title {
		font-family: "Newsreader", serif;
		font-size: clamp(30px, 3.4vw, 42px);
		letter-spacing: -0.015em;
		font-weight: 450;
		line-height: 1.1;
		margin: 0 0 26px;
		font-variation-settings: "opsz" 40;
	}
	.about-stats {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
	}
	.about-stats > div {
		flex: 1 1 110px;
	}
	.stat-num {
		font-family: "Newsreader", serif;
		font-size: 38px;
		color: var(--primary);
		line-height: 1;
	}
	.stat-label {
		font-size: 12.5px;
		color: var(--fg3);
		margin-top: 4px;
	}
	.about-para {
		font-size: 17px;
		line-height: 1.62;
		color: var(--fg2);
		margin: 0 0 34px;
	}
	.about-skills {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 34px;
	}
	.skill-group-wide {
		grid-column: 1 / -1;
	}
	.skill-head {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg3);
		margin-bottom: 14px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--line);
	}
	.chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}
	.skill-chip {
		font-size: 13px;
		font-weight: 500;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 8px;
		padding: 6px 12px;
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import ServicePaths from "../components/ServicePaths.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";

const pageTitle = "Josh Winningham | Web & Product Developer";
const pageDescription =
	"Josh Winningham, full-stack web and product developer: production web products built and operated end to end. Portfolio, résumé, and how to work with me. Founder of Scale Visibility.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Hero />
	<ServicePaths />
	<Work />
	<About />
	<Contact />
</Layout>

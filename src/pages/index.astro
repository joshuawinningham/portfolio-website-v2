---
import Layout from "../layouts/Layout.astro";
import ServicePaths from "../components/ServicePaths.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";

const pageTitle = "Josh Winningham | Website Designer & Developer";
const pageDescription =
	"Work directly with Josh Winningham, website designer and developer: websites that search engines and AI tools understand, with help after launch sized to the need.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Hero />
	<ServicePaths />
	<Work />
	<About />
	<Contact />
</Layout>

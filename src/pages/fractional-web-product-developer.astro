---
import Layout from "../layouts/FractionalLayout.astro";
import Icon from "../components/Icon.astro";
import ServiceProof from "../components/ServiceProof.astro";
import ContactForm from "../components/ContactForm.astro";
import ScaleVisibilityNote from "../components/ScaleVisibilityNote.astro";
import { developerProof } from "../data/serviceProof";

const inquiryHref = "mailto:joshua.winningham@gmail.com?subject=Fractional%20Web%20%26%20Product%20Development%20Inquiry";
const services = [
	{ title: "Websites & content systems", detail: "Build or improve a website with responsive layouts, editable content, and the structure it needs to support your business." },
	{ title: "Web applications & features", detail: "Build customer-facing applications and useful features, from account flows and dashboards to self-service tools." },
	{ title: "Internal tools", detail: "Turn repeated business tasks into practical software, with clear workflows, validation, and visibility into the work." },
	{ title: "APIs, data & integrations", detail: "Connect the interface to databases and third-party services, with the business rules that make the whole system work." },
	{ title: "Performance & reliability", detail: "Investigate slow pages and broken flows, improve accessibility, and test the behavior that matters to users." },
	{ title: "Maintenance & deployment", detail: "Maintain the codebase, fix issues, and deploy agreed releases, with documentation and a clear process for ongoing improvements." },
];
const steps = [
	{ title: "Understand the product and code.", detail: "We review the business need, current website or application, and technical constraints. We agree on priorities, capacity, and what a completed piece of work should do." },
	{ title: "Build in reviewable increments.", detail: "I implement the work and share changes you can review. We check the important user flows and resolve feedback before an agreed release." },
	{ title: "Release, maintain, and improve.", detail: "I support deployment, document what changed, and work through the next priorities. Maintenance and support expectations are defined as part of the engagement." },
];
---
<Layout
	title="Fractional Web & Product Developer | Josh Winningham"
	description="Work directly with Josh Winningham to build and improve websites, web applications, and internal tools, with agreed development capacity and ongoing technical execution."
>
	<section class="offer-hero wrap" aria-labelledby="offer-title">
		<div>
			<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Fractional Web &amp; Product Developer</p>
			<h1 id="offer-title">I turn business needs into <em>working web products.</em></h1>
			<p class="lede">Websites, web applications, and internal tools. Work directly with me to build useful features, improve what you have, and keep the technical work moving.</p>
			<div class="actions">
				<a href="#contact" class="button">Let’s talk about your project <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
				<a href="#proof" class="text-link">See relevant work <span aria-hidden="true">↓</span></a>
			</div>
			<p class="hero-note">Direct collaboration. Defined capacity. Working software.</p>
		</div>
		<aside class="system-map" aria-labelledby="system-title">
			<p class="eyebrow">From interface to operations</p>
			<h2 id="system-title">The whole application.</h2>
			<ol class="system-steps">
				<li><span class="step-number">01</span><div><h3>What people use</h3><p>Website · interface · customer flows</p></div></li>
				<li><span class="step-number">02</span><div><h3>What makes it work</h3><p>APIs · databases · integrations</p></div></li>
				<li><span class="step-number">03</span><div><h3>What keeps it useful</h3><p>Testing · releases · maintenance</p></div></li>
			</ol>
			<p class="map-caption">I work across the stack, with a clear view of the business problem the software needs to solve.</p>
		</aside>
	</section>

	<section class="scope-section" aria-labelledby="scope-title">
		<div class="wrap section-space">
			<div class="section-intro">
				<div><p class="eyebrow">Where I help</p><h2 id="scope-title">A website to improve.<br />A product to move forward.</h2></div>
				<p>Bring an existing site, a growing application, or a workflow that needs better software. I take on the agreed development work, from implementation through ongoing improvements.</p>
			</div>
			<div class="services">{services.map((service, index) => <article class="service"><span class="small-number">0{index + 1}</span><h3>{service.title}</h3><p>{service.detail}</p></article>)}</div>
		</div>
	</section>

	<ServiceProof items={developerProof} description="Examples from my existing portfolio: a provider marketplace and a tournament discovery product, with the interfaces, data, integrations, and workflows behind them." />

	<section id="how-it-works" class="wrap section-space" aria-labelledby="process-title">
		<div class="section-intro">
			<div><p class="eyebrow">Working together</p><h2 id="process-title">Development capacity,<br />with a clear direction.</h2></div>
				<p>A recurring engagement for an agreed share of my time. We choose the work together, keep the backlog realistic, and make progress visible.</p>
		</div>
		<ol class="process">{steps.map((step, index) => <li><span class="small-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.detail}</p></div></li>)}</ol>
		<div class="scope-note"><h3>Technical execution, with agreed boundaries.</h3><p>I own the development work we scope. You retain product direction, business priorities, budgets, and people management. Capacity, release approvals, and support coverage are agreed up front; additional work is scoped before it begins.</p></div>
	</section>

	<section class="background-section" aria-labelledby="background-title">
		<div class="wrap section-space background-grid">
			<div>
				<p class="eyebrow">Your working developer</p>
				<h2 id="background-title">A product-minded builder<br /><em>who stays close to the work.</em></h2>
				<p class="body-copy">I’m Josh Winningham, a full-stack product developer and Founder of Scale Visibility. I’ve built and operated production products with accounts, payments, databases, third-party integrations, and lifecycle workflows.</p>
				<p class="body-copy">Earlier, as founder and operator of MaidGrow, I oversaw development and launch of an estimate-calculator app, then managed user acquisition, support, and feature improvements informed by customer feedback. That experience shapes how I build today: from the business need through the work of keeping a product useful.</p>
				<p class="body-copy">My portfolio includes work with React, Next.js, TypeScript, Astro, WordPress, PostgreSQL, and ASP.NET Core. We’ll assess your existing stack and the work it needs before agreeing on a scope.</p>
				<a href="/#work" class="text-link">Explore the full portfolio <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
			</div>
			<ScaleVisibilityNote />
		</div>
	</section>

	<div class="wrap related-service">
		<p>Need someone to run the workflows behind your marketing?</p>
		<a href="/fractional-marketing-operations/" class="text-link">Explore Fractional Marketing Operations Partner <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
		<p class="related-note">For CRM, lead routing, follow-up automation, and reporting, start with marketing operations. If your needs span both services, we agree on responsibilities and capacity together, with overlapping work counted once.</p>
	</div>

	<section id="contact" class="wrap section-space inquiry" aria-labelledby="contact-title">
		<div>
			<p class="eyebrow">Start a conversation</p>
			<h2 id="contact-title">Where does your business need<br /><em>ongoing development support?</em></h2>
			<p class="body-copy">Tell me what your business needs from its website, applications, or internal tools—and where progress is getting stuck. We’ll discuss your priorities, the hands-on work you need, and a clear scope for ongoing support.</p>
			<div class="inquiry-action">
				<p>You’ll be talking directly with me. Prefer email?</p>
				<a href={inquiryHref} class="email-address">joshua.winningham@gmail.com</a>
			</div>
		</div>
		<ContactForm subject="Fractional Web &amp; Product Development Inquiry" messagePlaceholder="Tell me about your business, your development priorities, and where you need ongoing help…" />
	</section>
</Layout>

---
import Layout from "../layouts/FractionalLayout.astro";
import Icon from "../components/Icon.astro";
import ServiceProof from "../components/ServiceProof.astro";
import ContactForm from "../components/ContactForm.astro";
import ScaleVisibilityNote from "../components/ScaleVisibilityNote.astro";
import { marketingProof } from "../data/serviceProof";

const inquiryHref = "mailto:joshua.winningham@gmail.com?subject=Fractional%20Marketing%20Operations%20Inquiry";
const services = [
	{ title: "Marketing workflows", detail: "Build and maintain the steps behind your marketing, with clear handoffs, agreed responsibilities, and a practical way to track the work." },
	{ title: "Lead capture & routing", detail: "Connect inquiries to the right destination, preserve useful context, and make the next action clear." },
	{ title: "CRM & pipeline operations", detail: "Organize contacts, stages, and handoffs so your team can see where leads stand and what needs attention." },
	{ title: "Follow-up automation", detail: "Set up practical confirmations, reminders, and follow-up workflows, then check that they keep working." },
	{ title: "Integrations & data flow", detail: "Connect the tools you already use, reduce repeated data entry, and troubleshoot the gaps between systems." },
	{ title: "Tracking & reporting", detail: "Set up useful tracking and reporting so you can understand activity, spot problems, and choose the next improvement." },
];
const steps = [
	{ title: "Agree on the priorities.", detail: "We review your current systems, the friction your team is facing, and what needs to work better. Together, we define the first priorities and the capacity to address them." },
	{ title: "Build, connect, and improve.", detail: "I do the hands-on work, test the changes, and document what your team needs to know. Within our agreed scope, I move work forward proactively and flag decisions that need your input." },
	{ title: "Keep the systems working.", detail: "We review progress, address issues, and adjust the next priorities. You have a clear view of what changed, what is in progress, and what comes next." },
];
---

<Layout
	title="Fractional Marketing Operations Partner | Josh Winningham"
	description="Work directly with Josh Winningham on CRM, lead capture, follow-up automation, marketing workflows, integrations, and reporting. Hands-on marketing systems ownership."
>
	<section class="offer-hero wrap" aria-labelledby="offer-title">
		<div>
			<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Fractional Marketing Operations Partner</p>
			<h1 id="offer-title">I build and run the systems that make <em>marketing work.</em></h1>
			<p class="lede">CRM, lead capture, follow-up automation, marketing workflows, integrations, and reporting. Work directly with me to connect the pieces and keep them running.</p>
			<div class="actions">
				<a href="#contact" class="button">Let’s talk about your systems <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
				<a href="#how-it-works" class="text-link">How we work together <span aria-hidden="true">↓</span></a>
			</div>
			<p class="hero-note">Hands-on execution. Agreed priorities. Ongoing attention.</p>
		</div>
		<aside class="system-map" aria-labelledby="system-title">
			<p class="eyebrow">The connected picture</p>
			<h2 id="system-title">Every handoff matters.</h2>
			<ol class="system-steps">
				<li><span class="step-number">01</span><div><h3>Capture the interest</h3><p>Forms · lead routing · inquiry context</p></div></li>
				<li><span class="step-number">02</span><div><h3>Make the next step clear</h3><p>CRM · routing · follow-up</p></div></li>
				<li><span class="step-number">03</span><div><h3>See what needs attention</h3><p>Tracking · reporting · improvements</p></div></li>
			</ol>
			<p class="map-caption">I work across these connections, from the first form to the ongoing workflow.</p>
		</aside>
	</section>

	<section class="scope-section" aria-labelledby="scope-title">
		<div class="wrap section-space">
			<div class="section-intro">
				<div><p class="eyebrow">Where I help</p><h2 id="scope-title">The work behind<br />the marketing.</h2></div>
				<p>You have goals to move toward and tools to work with. I bring the technical execution and ongoing operations to help those tools serve your team.</p>
			</div>
			<div class="services">
				{services.map((service, index) => <article class="service"><span class="small-number">0{index + 1}</span><h3>{service.title}</h3><p>{service.detail}</p></article>)}
			</div>
		</div>
	</section>

	<ServiceProof items={marketingProof} description="Examples from products I build and operate: customer onboarding, automated communication, connected workflows, and reporting. These show the hands-on systems experience I bring to marketing operations." />

	<section id="how-it-works" class="wrap section-space" aria-labelledby="process-title">
		<div class="section-intro">
			<div><p class="eyebrow">Working together</p><h2 id="process-title">A clear scope.<br />Someone moving it forward.</h2></div>
			<p>This is a recurring engagement for a defined share of my time and attention. We agree on priorities, capacity, and communication before work begins.</p>
		</div>
		<ol class="process">
			{steps.map((step, index) => <li><span class="small-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.detail}</p></div></li>)}
		</ol>
		<div class="scope-note"><h3>Clear responsibilities, from the start.</h3><p>I own the hands-on work we agree to. You retain ownership of overall marketing strategy, budgets, and people management. Requests are prioritized within our agreed capacity; additional work is scoped before it begins.</p></div>
	</section>

	<section class="background-section" aria-labelledby="background-title">
		<div class="wrap section-space background-grid">
			<div>
				<p class="eyebrow">Your working partner</p>
				<h2 id="background-title">A builder with an<br /><em>operator’s perspective.</em></h2>
				<p class="body-copy">I’m Josh Winningham, a full-stack product developer and Founder of Scale Visibility. My background includes 16+ years operating remote digital businesses. Today I build and maintain the software behind real workflows.</p>
				<p class="body-copy">At Cleaning Business Academy, I built and operated an educational digital business, grew its email audience, sold an online course, and handled customer support, refunds, and ongoing customer communication.</p>
				<p class="body-copy">That experience sits alongside the technical work shown here: capturing inquiries, connecting systems, and building reporting. I understand the ongoing work around a customer relationship and bring that perspective to the systems I build and run.</p>
				<a href="/#work" class="text-link">Explore my products and technical work <Icon name="arrow-right" size={18} aria-hidden="true" /></a>
			</div>
			<ScaleVisibilityNote />
		</div>
	</section>

	<div class="wrap related-service"><p>Need dedicated help building a website or application?</p><a href="/fractional-web-product-developer/" class="text-link">Explore Fractional Web &amp; Product Developer <Icon name="arrow-right" size={18} aria-hidden="true" /></a><p class="related-note">If your needs span both services, we agree on responsibilities and capacity together. Overlapping work is counted once.</p></div>

	<section id="contact" class="wrap section-space inquiry" aria-labelledby="contact-title">
		<div>
			<p class="eyebrow">Start a conversation</p>
			<h2 id="contact-title">Where does your business need<br /><em>marketing operations support?</em></h2>
			<p class="body-copy">Tell me where your business needs ongoing help with lead capture, follow-up, connected systems, or reporting. We’ll discuss your priorities, the hands-on work you need, and a clear scope for ongoing support.</p>
			<div class="inquiry-action">
				<p>You’ll be talking directly with me. Prefer email?</p>
				<a href={inquiryHref} class="email-address">joshua.winningham@gmail.com</a>
			</div>
		</div>
		<ContactForm subject="Fractional Marketing Operations Inquiry" messagePlaceholder="Tell me about your business, your marketing systems, and where you need ongoing help…" />
	</section>
</Layout>
